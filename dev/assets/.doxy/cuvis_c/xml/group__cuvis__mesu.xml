<parameternamelist>
<parametername direction="in">i_mesu</parametername>
</parameternamelist>
<parameterdescription>
<para>The measurements to be changed </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_name</parametername>
