        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_measurement_set_name</definition>
        <argsstring>(CUVIS_MESU const i_mesu, const CUVIS_CHAR *i_name)</argsstring>
        <name>cuvis_measurement_set_name</name>
