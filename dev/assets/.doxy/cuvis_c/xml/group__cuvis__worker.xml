<parameternamelist>
<parametername direction="out">o_pWorker</parametername>
</parameternamelist>
<parameterdescription>
<para>The worker handle to be created </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">worker_settings</parametername>
</parameternamelist>
<parameterdescription>
<para>The worker configuration </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
