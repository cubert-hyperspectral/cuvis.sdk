      <memberdef kind="function" id="group__cuvis__session_1ga9d470ba12611e6b5112a5d7d991c8228" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_session_file_load</definition>
        <argsstring>(const CUVIS_CHAR *i_path, CUVIS_SESSION_FILE *o_pSess)</argsstring>
        <name>cuvis_session_file_load</name>
        <param>
          <type>const <ref refid="cuvis_8h_1ad6fd13ac609b8cbfad5f49e5ff0e11d3" kindref="member">CUVIS_CHAR</ref> *</type>
          <declname>i_path</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref> *</type>
          <declname>o_pSess</declname>
        </param>
        <briefdescription>
<para>Load a session_info file from disk. </para>
        </briefdescription>
        <detaileddescription>
<para>The session_info file is a cu3s file and consists of binary cu3 measurement data. Call <ref refid="group__cuvis__session_1ga4ef5a62c11e92504516693c7643be105" kindref="member">cuvis_session_file_get_mesu</ref> to obtain a single measurement frame. SessionFile files can be create with the Cube Exporter (see <ref refid="group__cuvis__exporter_1gac8dbccda0642d3ed2cbcf432ab699712" kindref="member">cuvis_exporter_create_cube</ref>) <simplesect kind="note"><para>Do not read a file currently opened for writing.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">i_path</parametername>
</parameternamelist>
<parameterdescription>
<para>the file path of the session_info file </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">o_pSess</parametername>
</parameternamelist>
<parameterdescription>
<para>the handle of the session_info file. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9dad52787b0cfb0da2c053a68bcdc54bc6f" kindref="member">status_ok</ref>, if the measurement could be loaded. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="docs/_api_sources/cuvis.h" line="2008" column="33" declfile="docs/_api_sources/cuvis.h" declline="2008" declcolumn="33"/>
      </memberdef>
      <memberdef kind="function" id="group__cuvis__session_1gaaad14206a0e3aecfe4081f61b5e11f8e" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_session_file_free</definition>
        <argsstring>(CUVIS_SESSION_FILE *o_pSess)</argsstring>
        <name>cuvis_session_file_free</name>
        <param>
          <type><ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref> *</type>
          <declname>o_pSess</declname>
        </param>
        <briefdescription>
<para>Release a session_info file handle. </para>
        </briefdescription>
        <detaileddescription>
<para>Release a measurement by it&apos;s handle. The handle will be overwritten to <ref refid="cuvis_8h_1a3bd1442bbbbac3d65f28f5738b2743ed" kindref="member">CUVIS_HANDLE_NULL</ref> This will not affect any measurements on disk. Measurements loaded from the session_info file remain valid.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="inout">o_pSess</parametername>
</parameternamelist>
<parameterdescription>
<para>The handle to the measurement to be deleted </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9dad52787b0cfb0da2c053a68bcdc54bc6f" kindref="member">status_ok</ref> if the session_info file was released. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
