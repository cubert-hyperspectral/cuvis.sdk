        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_session_file_get_fps</definition>
        <argsstring>(CUVIS_SESSION_FILE i_sess, double *o_pFps)</argsstring>
        <name>cuvis_session_file_get_fps</name>
        <param>
          <type><ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref></type>
          <declname>i_sess</declname>
        </param>
        <param>
          <type>double *</type>
          <declname>o_pFps</declname>
        </param>
        <briefdescription>
<para>get a session_info file&apos;s FPS </para>
        </briefdescription>
        <detaileddescription>
<para>The session_info file meta-Information will be available only if the mode <ref refid="group__cuvis__session_1gae652b04fd2cee307d30c4f491105fe5d" kindref="member">cuvis_session_file_get_operation_mode</ref> returns &quot;Internal&quot;</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
