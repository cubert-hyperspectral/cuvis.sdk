        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_session_file_copy_handle</definition>
        <argsstring>(CUVIS_SESSION_FILE i_sess, CUVIS_SESSION_FILE *o_pSess)</argsstring>
        <name>cuvis_session_file_copy_handle</name>
        <param>
          <type><ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref></type>
