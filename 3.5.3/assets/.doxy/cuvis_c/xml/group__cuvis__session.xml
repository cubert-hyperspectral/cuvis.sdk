        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_session_file_get_mesu</definition>
        <argsstring>(CUVIS_SESSION_FILE i_sess, CUVIS_INT i_frameNo, CUVIS_SESSION_ITEM_TYPE i_type, CUVIS_MESU *o_pMesu)</argsstring>
        <name>cuvis_session_file_get_mesu</name>
        <param>
          <type><ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref></type>
          <declname>i_sess</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1a411e2de5f4fe2d2210e985d8f323b144" kindref="member">CUVIS_INT</ref></type>
          <declname>i_frameNo</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1ac2de12c445949bd33c16822784121d02" kindref="member">CUVIS_SESSION_ITEM_TYPE</ref></type>
          <declname>i_type</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1a79fa4e0f6faf8ddaabf6ee66dfa00d3e" kindref="member">CUVIS_MESU</ref> *</type>
          <declname>o_pMesu</declname>
        </param>
        <briefdescription>
<para>Load a measurement from the session_info file. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">i_sess</parametername>
</parameternamelist>
<parameterdescription>
<para>the session_info file handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_frameNo</parametername>
</parameternamelist>
<parameterdescription>
<para>the frame no. Counting from 0, must be below value of <ref refid="group__cuvis__session_1ga55ea068e315f18237e6a9e55cf71727e" kindref="member">cuvis_session_file_get_size</ref> of it&apos;s respective <computeroutput>i_type</computeroutput> </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_type</parametername>
</parameternamelist>
<parameterdescription>
<para>the type of listing (size depends on type) </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">o_pMesu</parametername>
</parameternamelist>
<parameterdescription>
<para>the handle of the measurement. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9dad52787b0cfb0da2c053a68bcdc54bc6f" kindref="member">status_ok</ref>, if the measurement could be loaded. <ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9da032fa1a5c4c2acdfd16268b2d7fa6f21" kindref="member">status_no_measurement</ref> if the measurement was dropped. <ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9da405da0d107497b3596a3818a48478c9f" kindref="member">status_error</ref> if the frame exeeds the number of frames. </para>
</simplesect>
</para>
        </detaileddescription>
