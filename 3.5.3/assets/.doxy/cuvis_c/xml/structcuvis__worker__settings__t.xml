      <memberdef kind="variable" id="structcuvis__worker__settings__t_1a1cc57943fddd0ceaf4b85f9b1c4cfc09" prot="public" static="no" mutable="no">
        <type><ref refid="cuvis_8h_1a411e2de5f4fe2d2210e985d8f323b144" kindref="member">CUVIS_INT</ref></type>
        <definition>CUVIS_INT cuvis_worker_settings_t::can_skip_measurements</definition>
        <argsstring></argsstring>
        <name>can_skip_measurements</name>
        <qualifiedname>cuvis_worker_settings_t::can_skip_measurements</qualifiedname>
        <briefdescription>
<para>Wether the worker is allowed to reject measurements from the acquisition context, if its queues are full. </para>
        </briefdescription>
        <detaileddescription>
<para>If set to true (1), the worker will skip processing measurements it pulls from the acqusition context, when its mandatory queue is full. If set to false (0), the worker will wait until a processing slot in its mandatory queue is available, before pulling a new measurement from the acquisition context. This setting DOES NOT apply to measurements and session files given to the worker via the &quot;cuvis_worker_ingest_xyz&quot; functions. </para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="docs/_api_sources/cuvis.h" line="1533" column="13" bodyfile="docs/_api_sources/cuvis.h" bodystart="1533" bodyend="-1"/>
      </memberdef>
