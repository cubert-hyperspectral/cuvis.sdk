      <memberdef kind="function" id="group__cuvis__proc_1ga0e7aefa748554ddefdab4749878785f9" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_proc_cont_get_reference</definition>
        <argsstring>(CUVIS_PROC_CONT i_procCont, CUVIS_MESU *o_pMesu, CUVIS_REFERENCE_TYPE i_type)</argsstring>
        <name>cuvis_proc_cont_get_reference</name>
        <param>
          <type><ref refid="cuvis_8h_1a53f231856522945c06cddf2c0fcdcf84" kindref="member">CUVIS_PROC_CONT</ref></type>
          <declname>i_procCont</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1a79fa4e0f6faf8ddaabf6ee66dfa00d3e" kindref="member">CUVIS_MESU</ref> *</type>
          <declname>o_pMesu</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1af7e5c2da78987108b31247352bb0f6d9" kindref="member">CUVIS_REFERENCE_TYPE</ref></type>
          <declname>i_type</declname>
        </param>
        <briefdescription>
<para>get a specific reference from the processing context </para>
        </briefdescription>
        <detaileddescription>
<para>The processing context can hold explicit references (e.g. a dark), see <ref refid="group__cuvis__proc_1ga970393728bb751fb2a8c179aeed69796" kindref="member">cuvis_proc_cont_set_reference</ref>. These reference can be obtained by this functions</para>
<para><simplesect kind="note"><para>Implicit references given by a measurement are not returned. If they are available can only be checked indirectly by the <ref refid="group__cuvis__proc_1ga0b11e01ef2b5936406483a94513754ae" kindref="member">cuvis_proc_cont_is_capable</ref> or by checking for the measurement&apos;s data keys <ref refid="group__cuvis__reserved__keys_1ga480fceda6d8ddaf26dc845baa4500840" kindref="member">CUVIS_MESU_DARKREF_KEY</ref>, <ref refid="group__cuvis__reserved__keys_1gad59d63faeaf80719a01053e3643a5b27" kindref="member">CUVIS_MESU_WHITEREF_KEY</ref> and <ref refid="group__cuvis__reserved__keys_1ga8a6644917100914942ad24fecd406901" kindref="member">CUVIS_MESU_WHITEDARKREF_KEY</ref></para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">i_procCont</parametername>
</parameternamelist>
<parameterdescription>
<para>The handle of the processing context </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">o_pMesu</parametername>
</parameternamelist>
<parameterdescription>
<para>The reference measurement&apos;s handle </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_type</parametername>
</parameternamelist>
<parameterdescription>
<para>The type of the measurement to be retrieved. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para><ref refid="group__cuvis__returns_1ggaa06c62ba25240f4763da0e590ebf3b9dad52787b0cfb0da2c053a68bcdc54bc6f" kindref="member">status_ok</ref> if the reference measurement is available and could be loaded </para>
</simplesect>
</para>
        </detaileddescription>
