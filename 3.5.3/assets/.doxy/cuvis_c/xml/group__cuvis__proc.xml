      <memberdef kind="function" id="group__cuvis__proc_1ga970393728bb751fb2a8c179aeed69796" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_proc_cont_set_reference</definition>
        <argsstring>(CUVIS_PROC_CONT i_procCont, CUVIS_MESU i_mesu, CUVIS_REFERENCE_TYPE i_type)</argsstring>
        <name>cuvis_proc_cont_set_reference</name>
        <param>
          <type><ref refid="cuvis_8h_1a53f231856522945c06cddf2c0fcdcf84" kindref="member">CUVIS_PROC_CONT</ref></type>
          <declname>i_procCont</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1a79fa4e0f6faf8ddaabf6ee66dfa00d3e" kindref="member">CUVIS_MESU</ref></type>
          <declname>i_mesu</declname>
        </param>
        <param>
          <type><ref refid="cuvis_8h_1af7e5c2da78987108b31247352bb0f6d9" kindref="member">CUVIS_REFERENCE_TYPE</ref></type>
          <declname>i_type</declname>
        </param>
        <briefdescription>
<para>Set a reference measurement. </para>
        </briefdescription>
        <detaileddescription>
<para>The available processing modes (<ref refid="cuvis_8h_1a0202f4d14b82cefb6ba0d79470335d88" kindref="member">cuvis_processing_mode_t</ref>) require certain references to be set. When a measurement is recorded with references in place, these references are available per measurement implicitly. However, if you want to process measurements with different references, or if the measurement lacks a reference, they can be set with this function.</para>
<para><programlisting><codeline><highlight class="normal">CUVIS_MESU<sp/>mesu;</highlight></codeline>
<codeline><highlight class="normal">cuvis_measurement_load(&quot;mesu.cu3&quot;,&amp;mesu);</highlight></codeline>
<codeline><highlight class="normal">//contains<sp/>implicit<sp/>Reference_Dark</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">CUVIS_PROC_CONT<sp/>pc;</highlight></codeline>
<codeline><highlight class="normal">cuvis_proc_cont_create_from_mesu(mesu,&amp;pc);<sp/>//will<sp/>implicitly<sp/>load<sp/>Reference_Dark</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">CUVIS_MESU<sp/>white;</highlight></codeline>
<codeline><highlight class="normal">cuvis_measurement_load(&quot;white.cu3&quot;,&amp;white);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">cuvis_proc_cont_set_reference(pc,<sp/>white,<sp/>Reference_White);</highlight></codeline>
<codeline></codeline>
<codeline><highlight class="normal">//Cube_Reflectance<sp/>requires<sp/>Reference_Dark<sp/>and<sp/>Reference_White</highlight></codeline>
<codeline><highlight class="normal">cuvis_proc_cont_apply(pc,mesu,{Cube_Reflectance});</highlight></codeline>
</programlisting> <simplesect kind="note"><para>The reference explicitly set by this function has priority over the implicit measurement.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">i_procCont</parametername>
</parameternamelist>
<parameterdescription>
<para>The handle of the processing context </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_mesu</parametername>
</parameternamelist>
<parameterdescription>
<para>The measurement to be used as explicit reference </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">i_type</parametername>
</parameternamelist>
<parameterdescription>
<para>The type of the reference </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
