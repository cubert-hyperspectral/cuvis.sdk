      <memberdef kind="function" id="group__cuvis__proc_1gaf0454eb5fe2e145eb05f187b570a28dc" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type><ref refid="cuvis_8h_1a069509dd952058b6b34d4a7bea70e01a" kindref="member">SDK_CAPI</ref> <ref refid="cuvis_8h_1afa3513af9e8156b171948745800b4ede" kindref="member">CUVIS_STATUS</ref> <ref refid="cuvis_8h_1a2364de41f8e53b2a5240dc71b82d7375" kindref="member">SDK_CCALL</ref></type>
        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_proc_cont_calc_distance</definition>
        <argsstring>(CUVIS_PROC_CONT i_procCont, double i_distanceMM)</argsstring>
        <name>cuvis_proc_cont_calc_distance</name>
        <param>
          <type><ref refid="cuvis_8h_1a53f231856522945c06cddf2c0fcdcf84" kindref="member">CUVIS_PROC_CONT</ref></type>
          <declname>i_procCont</declname>
        </param>
        <param>
          <type>double</type>
          <declname>i_distanceMM</declname>
        </param>
        <briefdescription>
<para>Set the operating distance by value. </para>
        </briefdescription>
        <detaileddescription>
<para>Some cameras require a distance reference (calibration). This is usually obtained from a measurement at that distance. However, if the distance is known, it can be set manually.</para>
<para><simplesect kind="note"><para>Some OEM-Cameras or older models do not support this. </para>
</simplesect>
<simplesect kind="note"><para>Internally, a measurement is created. It can be obtained by <ref refid="group__cuvis__proc_1ga0e7aefa748554ddefdab4749878785f9" kindref="member">cuvis_proc_cont_get_reference</ref>.</para>
</simplesect>
<parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">i_procCont</parametername>
</parameternamelist>
<parameterdescription>
<para>The handle of the processing context </para>
</parameterdescription>
</parameteritem>
