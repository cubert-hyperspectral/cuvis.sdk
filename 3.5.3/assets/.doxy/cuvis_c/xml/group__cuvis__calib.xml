        <definition>SDK_CAPI CUVIS_STATUS SDK_CCALL cuvis_calib_create_from_session_file</definition>
        <argsstring>(const CUVIS_SESSION_FILE i_sess, CUVIS_CALIB *o_pCalibration)</argsstring>
        <name>cuvis_calib_create_from_session_file</name>
        <param>
          <type>const <ref refid="cuvis_8h_1aafc04868b066901432da5a02e666727f" kindref="member">CUVIS_SESSION_FILE</ref></type>
